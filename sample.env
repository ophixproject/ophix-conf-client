# Ophix configuration client settings
# Copy to .conf.env in your project root

# URL of the configuration server (no trailing slash)
CONFSERVER_URL=https://confserver.internal

# API token — obtained via: conf-client register <n>
# CONFSERVER_API_TOKEN=

# Path to internal CA certificate (only needed for private CA)
# CONFSERVER_CA_CERT=

# ---------------------------------------------------------------------------
# Application configuration name mappings
# Add one entry per configuration your application needs.
# The value is the configuration name on the server.
# ---------------------------------------------------------------------------
# NGINX_UPSTREAM=nginx_upstream_prod
# APP_CONFIG=myapp_config_prod
